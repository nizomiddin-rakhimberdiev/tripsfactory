{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tripsfactory",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    // Payload and Next both reach for Node built-ins.
    "nodejs_compat",
    // The Sheets import fetches an xlsx export over HTTPS from a Worker.
    // Without this, fetch() to public URLs is blocked.
    "global_fetch_strictly_public"
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Media. The binding is what the Payload R2 storage plugin writes through,
  // so no API token lives in the Worker — the token exists only for the
  // one-off migration of the existing files out of Vercel Blob.
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "tripsfactory-media"
    },
    // The ISR output. Same bucket, different binding — the override namespaces
    // its objects under an `incremental-cache` prefix, so they do not mix with
    // the media files.
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "tripsfactory-media"
    }
  ],

  // Required by the R2 incremental cache: the Worker calls back into itself to
  // revalidate. The service name has to match "name" above.
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tripsfactory"
    }
  ],

  // Tag cache for revalidatePath(). Every Studio save goes through it — see
  // open-next.config.ts. Postgres stays where it is; this D1 database holds
  // nothing but invalidation bookkeeping.
  // TODO: replace with the id from `wrangler d1 create tripsfactory-tag-cache`.
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "tripsfactory",
      "database_id": "c94d87c0-6d47-4466-8c43-036093360000"
      // Deliberately not `remote`. Static generation renders 222 pages, and
      // pointing those queries at the real database makes every one a network
      // round trip from wherever the build runs — pages started timing out at
      // 60s. The build reads a local copy seeded from the same export
      // instead; the Worker itself always talks to the real D1, and ISR
      // re-renders against it, so nothing serves stale local data.
      //
      // Reseed after a schema change:
      //   wrangler d1 execute tripsfactory --local --file=<migration sql>
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "tripsfactory-tag-cache",
      "database_id": "d4f63a14-f5b0-48f7-be72-4e5a44605f3a"
    }
  ],

  "observability": {
    "enabled": true
  }
}
